# ─────────────────────────────────────────────────────────────
# U del Closer — environment variables
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored and must NEVER be committed.
# ─────────────────────────────────────────────────────────────

# Your Shopify store domain (no protocol, no trailing slash).
SHOPIFY_STORE_DOMAIN=tinomrkt.myshopify.com

# Storefront API access token (public scope — safe to use from the app).
# La tienda ya tiene el canal "Mi Tienda Headless": copia su token desde
# Shopify admin → Apps y canales de venta → Mi Tienda Headless →
# Storefront API → "Public access token".
SHOPIFY_STOREFRONT_TOKEN=your_storefront_api_token

# Storefront API version.
SHOPIFY_API_VERSION=2024-10

# Namespace de los metafields que enriquecen las tarjetas de membresía
# (badge, cta, features). Por defecto "custom".
SHOPIFY_METAFIELD_NS=custom

# Public site URL (used for metadata / canonical links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── DO NOT put the Admin API token in a frontend project. ──
# The Admin API token (shpat_...) grants broad write access to your store.
# A headless storefront only needs the Storefront token above.
# If you ever need Admin API access, keep it in a separate, server-only
# service and never expose it to the browser or commit it to git.
