{% comment %}
  U DEL CLOSER — Hero de producto
  Requiere estar en un bloque de la plantilla de PRODUCTO (usa el objeto `product`).
  Editable: eyebrow, título, subtítulo, bullets de confianza y texto del CTA.
{% endcomment %}
<section class="udc-hero" aria-label="Presentación del ebook">
  <div class="udc-hero__inner">
    <div class="udc-hero__copy">
      <span class="udc-hero__eyebrow">PARA VENDEDORES QUE QUIEREN CERRAR MÁS Y MEJOR</span>
      <h1 class="udc-hero__title">Convertite en el <span>Closer</span> que toda empresa quiere contratar</h1>
      <p class="udc-hero__subtitle">
        El método paso a paso para dejar de "vender" y empezar a <strong>cerrar</strong>: guiones,
        manejo de objeciones y el sistema exacto para transformar conversaciones en ventas de alto ticket.
      </p>

      <ul class="udc-hero__trust">
        <li>✔ Método probado en ventas reales</li>
        <li>✔ Acceso inmediato por email</li>
        <li>✔ Garantía de 7 días</li>
      </ul>

      <div class="udc-hero__price">
        {% if product.compare_at_price > product.price %}
          <span class="udc-hero__price-old">{{ product.compare_at_price | money }}</span>
        {% endif %}
        <span class="udc-hero__price-now">{{ product.price | money }}</span>
        <span class="udc-hero__price-note">pago único · acceso de por vida</span>
      </div>

      {% form 'product', product, class: 'udc-hero__form' %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        <button type="submit" class="udc-btn udc-btn--primary udc-hero__cta" data-udc-buy-now>
          QUIERO EL EBOOK AHORA →
        </button>
      {% endform %}

      <p class="udc-hero__social">🔥 Ya lo están usando cientos de vendedores en Latinoamérica</p>
    </div>

    <div class="udc-hero__visual" aria-hidden="true">
      <div class="udc-book">
        <div class="udc-book__spine"></div>
        <div class="udc-book__cover">
          <span class="udc-book__kicker">EBOOK DIGITAL</span>
          <span class="udc-book__title">CLOSER<br>DE VENTAS</span>
          <span class="udc-book__brand">U DEL CLOSER</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .udc-hero{
    background:radial-gradient(120% 140% at 80% 0%, var(--udc-red-glow,rgba(255,27,61,.35)) 0%, transparent 55%), var(--udc-black,#060606);
    color:var(--udc-white,#f7f7f7);font-family:var(--udc-font,sans-serif);
    padding:3.5rem 1rem;
  }
  .udc-hero__inner{
    max-width:var(--udc-container,1120px);margin:0 auto;
    display:grid;grid-template-columns:1.15fr .85fr;gap:3rem;align-items:center;
  }
  .udc-hero__eyebrow{
    display:inline-block;color:var(--udc-red,#ff1b3d);font-weight:800;
    font-size:.75rem;letter-spacing:.08em;margin-bottom:1rem;
  }
  .udc-hero__title{
    font-size:clamp(2rem,4.5vw,3.25rem);line-height:1.08;font-weight:800;margin:0 0 1rem;
  }
  .udc-hero__title span{color:var(--udc-red,#ff1b3d)}
  .udc-hero__subtitle{
    color:var(--udc-muted,#b8b8b8);font-size:1.05rem;line-height:1.6;max-width:38rem;margin:0 0 1.5rem;
  }
  .udc-hero__trust{list-style:none;margin:0 0 1.5rem;padding:0;display:flex;flex-wrap:wrap;gap:.5rem 1.25rem}
  .udc-hero__trust li{font-size:.85rem;color:var(--udc-white,#f7f7f7);opacity:.9}
  .udc-hero__price{display:flex;align-items:baseline;gap:.6rem;margin-bottom:1.25rem;flex-wrap:wrap}
  .udc-hero__price-old{color:var(--udc-muted,#b8b8b8);text-decoration:line-through;font-size:1.1rem}
  .udc-hero__price-now{font-size:2rem;font-weight:800;color:var(--udc-red,#ff1b3d)}
  .udc-hero__price-note{color:var(--udc-muted,#b8b8b8);font-size:.8rem}
  .udc-hero__form{margin:0 0 1rem}
  .udc-hero__social{color:var(--udc-muted,#b8b8b8);font-size:.85rem}

  .udc-btn{
    display:inline-flex;align-items:center;justify-content:center;gap:.5rem;
    border:0;border-radius:999px;cursor:pointer;font-weight:800;font-family:inherit;
    padding:1rem 2rem;font-size:1rem;transition:transform .15s ease, box-shadow .15s ease;
  }
  .udc-btn--primary{
    background:linear-gradient(135deg,var(--udc-red,#ff1b3d),var(--udc-red-dark,#b4001f));
    color:var(--udc-white,#f7f7f7);box-shadow:0 10px 30px -8px var(--udc-red-glow,rgba(255,27,61,.35));
  }
  .udc-btn--primary:hover{transform:translateY(-2px)}
  .udc-btn--primary:active{transform:translateY(0)}

  .udc-hero__visual{display:flex;justify-content:center;perspective:1200px}
  .udc-book{
    position:relative;width:220px;height:300px;transform-style:preserve-3d;
    transform:rotateY(-18deg) rotateX(2deg);animation:udc-float 5s ease-in-out infinite;
  }
  @keyframes udc-float{50%{transform:rotateY(-18deg) rotateX(2deg) translateY(-10px)}}
  .udc-book__cover{
    position:absolute;inset:0;border-radius:6px;
    background:linear-gradient(155deg,var(--udc-surface-2,#232323),var(--udc-black-soft,#121212));
    border:1px solid var(--udc-border,#2c2c2c);
    box-shadow:24px 24px 60px -20px rgba(0,0,0,.8), inset -3px 0 0 var(--udc-red,#ff1b3d);
    display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:.75rem;padding:1.5rem;
  }
  .udc-book__spine{
    position:absolute;left:-14px;top:4px;bottom:4px;width:14px;border-radius:4px 0 0 4px;
    background:linear-gradient(180deg,var(--udc-red,#ff1b3d),var(--udc-red-dark,#b4001f));
    transform:rotateY(90deg) translateX(-7px);transform-origin:right center;
  }
  .udc-book__kicker{font-size:.65rem;letter-spacing:.15em;color:var(--udc-red,#ff1b3d);font-weight:700}
  .udc-book__title{font-size:1.4rem;font-weight:800;color:var(--udc-white,#f7f7f7);line-height:1.15}
  .udc-book__brand{font-size:.65rem;color:var(--udc-muted,#b8b8b8);letter-spacing:.08em}

  @media (max-width:860px){
    .udc-hero__inner{grid-template-columns:1fr;gap:2.5rem;text-align:left}
    .udc-hero__visual{order:-1}
    .udc-book{width:170px;height:230px}
  }
  @media (prefers-reduced-motion:reduce){ .udc-book{animation:none} }
</style>

<script>
  (function(){
    var forms = document.querySelectorAll('.udc-hero__form');
    forms.forEach(function(form){
      form.addEventListener('submit', function(e){
        e.preventDefault();
        var formData = new FormData(form);
        fetch('/cart/add.js', { method:'POST', body:formData, headers:{'Accept':'application/json'} })
          .then(function(r){ return r.json(); })
          .then(function(){ window.location.href = '/checkout'; })
          .catch(function(){ form.submit(); });
      });
    });
  })();
</script>
