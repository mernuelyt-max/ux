    "udc_07": {
      "type": "udc-07-contenido",
      "blocks": {
        "b1": {
          "type": "chapter",
          "settings": {
            "title": "La mentalidad del closer",
            "text": "Cómo piensa quien cierra ventas todos los días y por qué la actitud vende antes que la técnica."
          }
        },
        "b2": {
          "type": "chapter",
          "settings": {
            "title": "Prospección inteligente",
            "text": "Dónde encontrar personas que ya quieren comprar y cómo abrir conversaciones sin sonar a vendedor."
          }
        },
        "b3": {
          "type": "chapter",
          "settings": {
            "title": "La llamada de venta",
            "text": "La estructura completa: apertura, diagnóstico y control de la conversación de principio a fin."
          }
        },
        "b4": {
          "type": "chapter",
          "settings": {
            "title": "Preguntas que califican",
            "text": "Cómo detectar si tenés a un comprador real adelante antes de gastar tu tiempo."
          }
        },
        "b5": {
          "type": "chapter",
          "settings": {
            "title": "Manejo de objeciones",
            "text": "Respuestas listas para \"es caro\", \"lo tengo que pensar\" y \"ahora no puedo\"."
          }
        },
        "b6": {
          "type": "chapter",
          "settings": {
            "title": "El cierre",
            "text": "Cómo pedir la venta, sostener el precio y no dejar la decisión para después."
          }
        },
        "b7": {
          "type": "chapter",
          "settings": {
            "title": "Seguimiento que convierte",
            "text": "El sistema de mensajes que recupera a los indecisos sin ser pesado."
          }
        },
        "b8": {
          "type": "chapter",
          "settings": {
            "title": "Tu agenda de closer",
            "text": "Cómo organizar tu día para cerrar más sin trabajar más horas."
          }
        }
      },
