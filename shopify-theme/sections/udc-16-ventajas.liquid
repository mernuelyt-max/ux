{%- comment -%}
  UDC 16 — Ventajas ("Por qué esta guía funciona")

  A partir de la sección "VENTAJAS" de design-reference/landing-base.html.
  Las 4 ventajas (b1..b4) ya estaban grabadas en templates/index.json antes
  de este archivo.
{%- endcomment -%}

{% render 'udc-base' %}

<section class="udc udc-top udc-vt" id="udc-vt-{{ section.id }}">
  <span class="udc-glow udc-vt__glow" aria-hidden="true"></span>

  <h2 class="udc-h2 udc-vt__title" data-udc-reveal>
    {{ section.settings.title_1 }}
    <span class="udc-serif udc-accent">{{ section.settings.title_2 }}</span>
  </h2>

  {%- if section.blocks.size > 0 -%}
    <div class="udc-vt__list">
      {%- for block in section.blocks -%}
        <div class="udc-vt__row" data-udc-reveal {{ block.shopify_attributes }}>
          <span class="udc-vt__num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <h3 class="udc-vt__ctitle">{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}
            <p class="udc-vt__ctext">{{ block.settings.text }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

<style>
  #udc-vt-{{ section.id }}{position:relative}
  #udc-vt-{{ section.id }} .udc-vt__glow{
    top:20%;right:-160px;width:520px;height:520px;filter:blur(100px);opacity:.18}

  #udc-vt-{{ section.id }} .udc-vt__title{margin:0 0 40px;max-width:900px;position:relative}

  #udc-vt-{{ section.id }} .udc-vt__list{display:flex;flex-direction:column;position:relative}
  #udc-vt-{{ section.id }} .udc-vt__row{
    display:grid;grid-template-columns:80px minmax(180px,1fr) 2fr;gap:20px;align-items:baseline;
    padding:30px 0;border-top:1px solid var(--udc-line2);transition:background .25s ease}
  #udc-vt-{{ section.id }} .udc-vt__row:last-child{border-bottom:1px solid var(--udc-line2)}
  #udc-vt-{{ section.id }} .udc-vt__row:hover{background:#0A0A09}
  #udc-vt-{{ section.id }} .udc-vt__num{font-family:var(--udc-anton);font-size:20px;color:var(--udc-accent)}
  #udc-vt-{{ section.id }} .udc-vt__ctitle{
    margin:0;font-family:var(--udc-anton);font-weight:400;text-transform:uppercase;
    font-size:clamp(15px,1.4vw,18px)}
  #udc-vt-{{ section.id }} .udc-vt__ctext{margin:0;color:var(--udc-muted);font-size:14px;line-height:1.55}

  @media (max-width:560px){
    #udc-vt-{{ section.id }} .udc-vt__row{grid-template-columns:1fr;gap:6px}
  }
</style>

{% schema %}
{
  "name": "UDC 16 · Ventajas",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "title_1", "label": "Título", "default": "Por qué esta" },
    { "type": "text", "id": "title_2", "label": "Título (acento serif itálica)", "default": "guía funciona" }
  ],
  "blocks": [
    {
      "type": "ventaja",
      "name": "Ventaja",
      "settings": [
        { "type": "text", "id": "title", "label": "Título" },
        { "type": "textarea", "id": "text", "label": "Texto" }
      ]
    }
  ],
  "presets": [{ "name": "UDC 16 · Ventajas" }]
}
{% endschema %}
