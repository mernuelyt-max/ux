{%- comment -%}
  UDC — Video de página de producto

  Sin diseño ni contenido recuperado (el artifact tenía un campo "videoUrl"
  en sus props, pero vacío por defecto y nunca se guardó ninguno real). El
  video (o los videos, si se usan bloques) se cargan desde el editor del
  tema — acá no hay ninguna URL puesta a mano.

  video_url es un setting nativo de Shopify que ya sabe resolver YouTube y
  Vimeo, así que no hace falta la lógica de regex que tenía el componente
  DCLogic del artifact (embedUrl()): external_video_tag la reemplaza.

  Pensada para templates/product.json (que tampoco existe todavía, ver
  README), junto con udc-prod-testimonios.
{%- endcomment -%}

{% render 'udc-base' %}

<section class="udc udc-top udc-vd" id="udc-vd-{{ section.id }}">
  {%- if section.settings.title != blank -%}
    <div class="udc-vd__head" data-udc-reveal>
      {%- if section.settings.eyebrow != blank -%}
        <span class="udc-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2 class="udc-h2 udc-vd__title">{{ section.settings.title }}</h2>
    </div>
  {%- endif -%}

  {%- if section.settings.video_url != blank -%}
    <div class="udc-vd__main" data-udc-reveal>
      <div class="udc-vd__frame">
        {{ section.settings.video_url | external_video_tag: class: 'udc-vd__iframe', loading: 'lazy' }}
      </div>
      {%- if section.settings.caption != blank -%}
        <p class="udc-vd__caption">{{ section.settings.caption }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if section.blocks.size > 0 -%}
    <div class="udc-vd__grid" data-udc-reveal>
      {%- for block in section.blocks -%}
        {%- render 'udc-video-card', block: block -%}
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

<style>
  #udc-vd-{{ section.id }}{position:relative}
  #udc-vd-{{ section.id }} .udc-vd__head{text-align:center;position:relative}
  #udc-vd-{{ section.id }} .udc-vd__title{margin-top:14px}

  #udc-vd-{{ section.id }} .udc-vd__main{max-width:820px;margin:44px auto 0;position:relative}
  #udc-vd-{{ section.id }} .udc-vd__frame{
    position:relative;aspect-ratio:16/9;border-radius:18px;overflow:hidden;
    border:1px solid var(--udc-border);background:var(--udc-bg2)}
  #udc-vd-{{ section.id }} .udc-vd__iframe{
    position:absolute;inset:0;width:100%;height:100%;border:0}
  #udc-vd-{{ section.id }} .udc-vd__caption{
    margin:14px 0 0;text-align:center;font-size:13px;color:var(--udc-muted)}

  #udc-vd-{{ section.id }} .udc-vd__grid{
    display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:20px;
    max-width:1080px;margin:44px auto 0;position:relative}
  #udc-vd-{{ section.id }} .udc-vd__grid .udc-vd__frame{aspect-ratio:9/16}
</style>

{% schema %}
{
  "name": "UDC · Video (producto)",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo" },
    { "type": "text", "id": "title", "label": "Título" },

    { "type": "header", "content": "Video principal (opcional)" },
    { "type": "video_url", "id": "video_url", "label": "Video", "accept": ["youtube", "vimeo"] },
    { "type": "text", "id": "caption", "label": "Pie de foto" }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Video",
      "settings": [
        { "type": "video_url", "id": "video_url", "label": "Video", "accept": ["youtube", "vimeo"] },
        { "type": "text", "id": "caption", "label": "Pie de foto" }
      ]
    }
  ],
  "presets": [{ "name": "UDC · Video (producto)" }]
}
{% endschema %}
