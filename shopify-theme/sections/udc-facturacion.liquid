{%- comment -%}
  UDC — Facturación de alumnos

  Esta sección no estaba en design-reference/landing-base.html: se agregó
  después, por chat (ver README, "Rescate 1"). Los 5 alumnos (f1..f5, con
  image/amount/period/name) y el disclaimer ya estaban grabados en
  templates/index.json antes de este archivo, con dos modos de layout ya
  previstos ahí (layout: "carousel", con interval y wall_speed).

  Tarjetas en formato 9:16 (historia/reel), a pedido del usuario:
   · "carousel" — coverflow: la tarjeta activa al centro, con glow rojo que
     late y un brillo que la cruza; las vecinas asoman a los costados, más
     chicas y apagadas. Avanza sola cada `interval` segundos, se pausa con
     el mouse encima, y se navega con flechas, puntos, swipe o tocando una
     tarjeta lateral. Loop infinito sin clonar nodos (cada slide calcula su
     offset circular respecto de la activa).
   · "wall" — marquesina horizontal con todas las tarjetas 9:16 a la vez.

  No se inventó ni un nombre ni un monto: los 5 casos son los que ya estaban
  grabados. Las fotos (udc-facturado-*.jpg) nunca se recuperaron; mientras no
  se suban a Archivos, cada tarjeta muestra la inicial del alumno de fondo
  (ver snippets/udc-factu-card.liquid).
{%- endcomment -%}

{% render 'udc-base' %}

<section class="udc udc-top udc-fc" id="udc-fc-{{ section.id }}">
  <span class="udc-glow udc-fc__glow" aria-hidden="true"></span>

  <div class="udc-fc__head" data-udc-reveal>
    {%- if section.settings.eyebrow != blank -%}
      <span class="udc-eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    <h2 class="udc-h2 udc-fc__title">
      {{ section.settings.title_1 }}<br>
      <span class="udc-serif udc-serif-glow">{{ section.settings.title_2 }}</span>
    </h2>
  </div>

  {%- if section.blocks.size > 0 -%}
    {%- if section.settings.layout == 'wall' -%}
      <div class="udc-fc__wall" data-udc-reveal>
        <div class="udc-marquee udc-fc__mq" style="animation-duration:{{ section.settings.wall_speed | default: 7 | times: 6 }}s">
          {%- for pass in (1..2) -%}
            <div class="udc-marquee__row udc-fc__row"{% if forloop.index == 2 %} aria-hidden="true"{% endif %}>
              {%- for block in section.blocks -%}
                {%- render 'udc-factu-card', block: block, tag: section.settings.card_tag -%}
              {%- endfor -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- else -%}
      <div class="udc-fc__carousel" data-udc-reveal data-interval="{{ section.settings.interval | default: 4 }}">
        <div class="udc-fc__stage" data-udc-fc-stage>
          {%- for block in section.blocks -%}
            <div class="udc-fc__slide{% if forloop.first %} is-active{% endif %}" data-udc-fc-slide="{{ forloop.index0 }}">
              {%- render 'udc-factu-card', block: block, tag: section.settings.card_tag -%}
            </div>
          {%- endfor -%}
        </div>

        {%- if section.blocks.size > 1 -%}
          <div class="udc-fc__controls">
            <button type="button" class="udc-fc__arrow" data-udc-fc-prev aria-label="Caso anterior">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 18l-6-6 6-6"/></svg>
            </button>
            <div class="udc-fc__dots">
              {%- for block in section.blocks -%}
                <button type="button" class="udc-fc__dot{% if forloop.first %} is-active{% endif %}"
                        data-udc-fc-dot="{{ forloop.index0 }}" aria-label="Ver caso {{ forloop.index }}"></button>
              {%- endfor -%}
            </div>
            <button type="button" class="udc-fc__arrow" data-udc-fc-next aria-label="Caso siguiente">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M9 18l6-6-6-6"/></svg>
            </button>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  {%- endif -%}

  {%- if section.settings.disclaimer != blank -%}
    <p class="udc-fc__disclaimer">{{ section.settings.disclaimer }}</p>
  {%- endif -%}
</section>

<style>
  #udc-fc-{{ section.id }}{position:relative;overflow:hidden;--fc-w:clamp(210px,58vw,280px)}
  #udc-fc-{{ section.id }} .udc-fc__glow{
    top:48%;left:50%;translate:-50% -50%;width:560px;height:560px;filter:blur(120px);opacity:.28}
  #udc-fc-{{ section.id }} .udc-fc__head{text-align:center;position:relative}
  #udc-fc-{{ section.id }} .udc-fc__title{margin-top:14px}

  /* Tarjeta 9:16 */
  #udc-fc-{{ section.id }} .udc-fc__card{
    position:relative;width:var(--fc-w);aspect-ratio:9/16;border-radius:22px;overflow:hidden;isolation:isolate;
    border:1px solid var(--udc-border);
    background:
      radial-gradient(120% 60% at 50% 100%, color-mix(in srgb, var(--udc-accent) 40%, transparent), transparent 62%),
      linear-gradient(180deg,#161111,#070707);
    box-shadow:0 30px 70px rgba(0,0,0,.7)}
  #udc-fc-{{ section.id }} .udc-fc__img{
    position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0}
  #udc-fc-{{ section.id }} .udc-fc__mono{
    position:absolute;inset:0;z-index:0;display:flex;align-items:center;justify-content:center;
    font-family:var(--udc-anton);font-size:calc(var(--fc-w) * .9);line-height:1;
    color:rgba(255,255,255,.045);text-transform:uppercase;user-select:none}
  #udc-fc-{{ section.id }} .udc-fc__shade{
    position:absolute;inset:0;z-index:1;pointer-events:none;
    background:linear-gradient(180deg,rgba(0,0,0,.45) 0%,transparent 22%,transparent 48%,rgba(0,0,0,.92) 100%)}
  #udc-fc-{{ section.id }} .udc-fc__tag{
    position:absolute;top:14px;left:14px;z-index:2;display:inline-flex;align-items:center;gap:6px;
    font-size:10px;letter-spacing:.2em;text-transform:uppercase;font-weight:700;color:#fff;
    background:rgba(5,5,5,.55);border:1px solid rgba(255,255,255,.12);border-radius:999px;padding:6px 12px;
    backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px)}
  #udc-fc-{{ section.id }} .udc-fc__tag span{color:var(--udc-accent)}
  #udc-fc-{{ section.id }} .udc-fc__body{
    position:absolute;left:0;right:0;bottom:0;z-index:2;padding:20px 20px 22px;
    display:flex;flex-direction:column;gap:4px}
  #udc-fc-{{ section.id }} .udc-fc__amount{
    font-family:var(--udc-anton);font-size:calc(var(--fc-w) * .21);line-height:1;color:var(--udc-accent);
    text-shadow:0 0 30px color-mix(in srgb, var(--udc-accent) 65%, transparent)}
  #udc-fc-{{ section.id }} .udc-fc__name{font-size:15px;font-weight:700;color:var(--udc-text)}
  #udc-fc-{{ section.id }} .udc-fc__period{font-size:12px;color:var(--udc-muted)}

  /* Brillo que cruza la tarjeta activa */
  #udc-fc-{{ section.id }} .udc-fc__card::after{
    content:'';position:absolute;inset:0;z-index:3;pointer-events:none;
    background:linear-gradient(105deg,transparent 38%,rgba(255,255,255,.16) 50%,transparent 62%);
    transform:translateX(-130%)}

  /* Carrusel coverflow */
  #udc-fc-{{ section.id }} .udc-fc__carousel{position:relative;margin-top:36px}
  #udc-fc-{{ section.id }} .udc-fc__stage{
    position:relative;height:calc(var(--fc-w) * 16 / 9 + 48px);touch-action:pan-y;user-select:none}
  #udc-fc-{{ section.id }} .udc-fc__slide{
    position:absolute;top:24px;left:50%;width:var(--fc-w);margin-left:calc(var(--fc-w) / -2);
    transform:translateX(calc(var(--o, 0) * var(--fc-w) * .64)) scale(var(--s, 1));
    transition:transform .75s cubic-bezier(.2,.7,.2,1),opacity .75s ease,filter .75s ease;
    opacity:0;pointer-events:none;z-index:1}
  #udc-fc-{{ section.id }} .udc-fc__slide.is-active{opacity:1;pointer-events:auto;z-index:3}
  #udc-fc-{{ section.id }} .udc-fc__slide[data-pos="1"]{
    opacity:.55;filter:brightness(.55) saturate(.8);pointer-events:auto;cursor:pointer;z-index:2}
  #udc-fc-{{ section.id }} .udc-fc__slide[data-pos="2"]{opacity:.22;filter:brightness(.4);z-index:1}
  #udc-fc-{{ section.id }} .udc-fc__slide[data-pos="hidden"]{opacity:0}

  #udc-fc-{{ section.id }} .udc-fc__slide.is-active .udc-fc__card{
    border-color:var(--udc-accent);animation:udcFcGlow 3.2s ease-in-out infinite}
  #udc-fc-{{ section.id }} .udc-fc__slide.is-active .udc-fc__card::after{animation:udcFcShine 4.8s ease-in-out infinite 1s}
  #udc-fc-{{ section.id }} .udc-fc__slide.is-active .udc-fc__img{animation:udcFcZoom 9s ease-out forwards}

  #udc-fc-{{ section.id }} .udc-fc__controls{
    position:relative;z-index:4;display:flex;align-items:center;justify-content:center;gap:18px;margin-top:18px}
  #udc-fc-{{ section.id }} .udc-fc__arrow{
    width:44px;height:44px;border-radius:50%;padding:0;cursor:pointer;
    display:inline-flex;align-items:center;justify-content:center;
    color:var(--udc-text);background:var(--udc-bg2);border:1px solid var(--udc-border);
    transition:border-color .2s ease,box-shadow .2s ease,color .2s ease}
  #udc-fc-{{ section.id }} .udc-fc__arrow:hover{
    border-color:var(--udc-accent);color:var(--udc-accent);
    box-shadow:0 0 24px color-mix(in srgb, var(--udc-accent) 40%, transparent)}
  #udc-fc-{{ section.id }} .udc-fc__dots{display:flex;gap:8px}
  #udc-fc-{{ section.id }} .udc-fc__dot{
    width:7px;height:7px;border-radius:999px;background:var(--udc-line2);border:0;padding:0;cursor:pointer;
    transition:width .3s ease,background .3s ease}
  #udc-fc-{{ section.id }} .udc-fc__dot.is-active{
    width:22px;background:var(--udc-accent);box-shadow:0 0 12px color-mix(in srgb, var(--udc-accent) 60%, transparent)}

  /* Marquesina (layout "wall") */
  #udc-fc-{{ section.id }} .udc-fc__wall{--fc-w:180px;overflow:hidden;margin-top:44px;position:relative;padding:20px 0}
  #udc-fc-{{ section.id }} .udc-fc__mq{animation-name:udcMarquee;animation-timing-function:linear;animation-iteration-count:infinite}
  #udc-fc-{{ section.id }} .udc-fc__row{gap:16px;padding-right:16px}
  #udc-fc-{{ section.id }} .udc-fc__row .udc-fc__card{flex:0 0 auto}

  #udc-fc-{{ section.id }} .udc-fc__disclaimer{
    position:relative;margin:32px auto 0;max-width:640px;text-align:center;font-size:11.5px;line-height:1.55;color:#6E6A64}

  @keyframes udcFcGlow{
    0%,100%{box-shadow:0 0 0 1px var(--udc-accent),0 0 36px color-mix(in srgb, var(--udc-accent) 35%, transparent),0 30px 70px rgba(0,0,0,.7)}
    50%{box-shadow:0 0 0 1px var(--udc-accent),0 0 90px color-mix(in srgb, var(--udc-accent) 65%, transparent),0 30px 70px rgba(0,0,0,.7)}}
  @keyframes udcFcShine{0%{transform:translateX(-130%)}35%,100%{transform:translateX(130%)}}
  @keyframes udcFcZoom{from{transform:scale(1)}to{transform:scale(1.08)}}

  @media (prefers-reduced-motion: reduce){
    #udc-fc-{{ section.id }} .udc-fc__slide{transition:none}
    #udc-fc-{{ section.id }} .udc-fc__card,
    #udc-fc-{{ section.id }} .udc-fc__card::after,
    #udc-fc-{{ section.id }} .udc-fc__img,
    #udc-fc-{{ section.id }} .udc-fc__mq{animation:none !important}
  }
</style>

<script>
  (function () {
    var root = document.getElementById('udc-fc-{{ section.id }}');
    if (!root) return;
    var carousel = root.querySelector('.udc-fc__carousel');
    if (!carousel) return;
    var slides = Array.prototype.slice.call(carousel.querySelectorAll('[data-udc-fc-slide]'));
    var dots = Array.prototype.slice.call(carousel.querySelectorAll('[data-udc-fc-dot]'));
    var n = slides.length;
    if (!n) return;

    var active = 0;
    var render = function () {
      slides.forEach(function (slide, i) {
        var o = i - active;
        if (o > n / 2) o -= n;
        if (o < -n / 2) o += n;
        var a = Math.abs(o);
        slide.style.setProperty('--o', o);
        slide.style.setProperty('--s', a === 0 ? 1 : (a === 1 ? 0.84 : 0.7));
        slide.setAttribute('data-pos', a > 2 ? 'hidden' : String(a));
        slide.classList.toggle('is-active', o === 0);
      });
      dots.forEach(function (d, i) { d.classList.toggle('is-active', i === active); });
    };
    var go = function (i) { active = (i + n) % n; render(); };
    render();
    if (n < 2) return;

    var interval = (parseFloat(carousel.getAttribute('data-interval')) || 4) * 1000;
    var timer = null;
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var start = function () { if (reduce) return; stop(); timer = setInterval(function () { go(active + 1); }, interval); };
    var stop = function () { if (timer) clearInterval(timer); timer = null; };
    var nudge = function (i) { go(i); start(); };

    var prev = carousel.querySelector('[data-udc-fc-prev]');
    var next = carousel.querySelector('[data-udc-fc-next]');
    if (prev) prev.addEventListener('click', function () { nudge(active - 1); });
    if (next) next.addEventListener('click', function () { nudge(active + 1); });
    dots.forEach(function (d, i) { d.addEventListener('click', function () { nudge(i); }); });
    slides.forEach(function (slide, i) {
      slide.addEventListener('click', function () { if (i !== active) nudge(i); });
    });

    var stage = carousel.querySelector('[data-udc-fc-stage]');
    var x0 = null;
    stage.addEventListener('touchstart', function (e) { x0 = e.touches[0].clientX; stop(); }, { passive: true });
    stage.addEventListener('touchend', function (e) {
      if (x0 === null) return;
      var dx = e.changedTouches[0].clientX - x0;
      x0 = null;
      if (Math.abs(dx) > 40) nudge(dx < 0 ? active + 1 : active - 1); else start();
    });
    carousel.addEventListener('mouseenter', stop);
    carousel.addEventListener('mouseleave', start);
    start();
  })();
</script>

{% schema %}
{
  "name": "UDC · Facturación",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Facturación de alumnos" },
    { "type": "text", "id": "title_1", "label": "Título · línea 1", "default": "Lo que están facturando" },
    { "type": "text", "id": "title_2", "label": "Título · línea 2 (serif itálica)", "default": "nuestros alumnos" },
    { "type": "text", "id": "card_tag", "label": "Píldora de cada tarjeta", "default": "Facturado" },
    {
      "type": "select", "id": "layout", "label": "Diseño", "default": "carousel",
      "options": [
        { "value": "carousel", "label": "Carrusel 9:16 (coverflow)" },
        { "value": "wall", "label": "Marquesina (todas a la vez)" }
      ]
    },
    { "type": "range", "id": "interval", "label": "Segundos por tarjeta (carrusel)", "min": 2, "max": 10, "default": 4 },
    { "type": "range", "id": "wall_speed", "label": "Velocidad (marquesina)", "min": 3, "max": 20, "unit": "s", "default": 7 },
    { "type": "textarea", "id": "disclaimer", "label": "Aclaración legal" }
  ],
  "blocks": [
    {
      "type": "caso",
      "name": "Alumno",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Foto (vertical 9:16)" },
        { "type": "text", "id": "amount", "label": "Monto", "info": "Ej: 200K" },
        { "type": "text", "id": "name", "label": "Nombre" },
        { "type": "text", "id": "period", "label": "Detalle", "info": "Ej: Closer de ventas · 2025" }
      ]
    }
  ],
  "presets": [{ "name": "UDC · Facturación" }]
}
{% endschema %}
