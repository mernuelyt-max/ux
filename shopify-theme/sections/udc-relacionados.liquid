{%- comment -%}
  UDC — "También te puede interesar" (productos relacionados)

  Inspirado en el bloque del mismo nombre de voltra.com.ar (referencia que
  mandó el usuario), con el sistema visual de UDC.

  Los productos salen de settings.products (selector de productos del
  editor). Si la lista está vacía, usa todos los productos de la tienda.
  En ambos casos se excluyen el producto que se está viendo, los que ya
  están en el carrito y los que no están disponibles, y se muestran como
  máximo settings.limit. Se usa en producto y en carrito.

  Precio, precio tachado y -% salen en vivo de la primera variante
  disponible de cada producto (en los productos con selector de cantidad,
  es la opción "1 copia"). El botón "Agregar" es un POST normal a /cart/add
  con esa variante — funciona sin JS y lleva al carrito.
{%- endcomment -%}

{% render 'udc-base' %}

{%- if section.settings.products.size > 0 -%}
  {%- assign source = section.settings.products -%}
{%- else -%}
  {%- assign source = collections.all.products -%}
{%- endif -%}

{%- assign in_cart = cart.items | map: 'product_id' | join: ',' | prepend: ',' | append: ',' -%}

{%- capture cards -%}
  {%- assign shown = 0 -%}
  {%- for p in source -%}
    {%- if shown >= section.settings.limit -%}{%- break -%}{%- endif -%}
    {%- if p.id == product.id or p.available == false -%}{%- continue -%}{%- endif -%}
    {%- assign needle = ',' | append: p.id | append: ',' -%}
    {%- if in_cart contains needle -%}{%- continue -%}{%- endif -%}
    {%- assign v = p.selected_or_first_available_variant -%}
    {%- assign shown = shown | plus: 1 -%}
    <article class="udc-rl__card">
      <a class="udc-rl__media" href="{{ p.url }}" tabindex="-1" aria-hidden="true">
        {%- if p.featured_image != blank -%}
          <img src="{{ p.featured_image | image_url: width: 500 }}" loading="lazy"
               width="{{ p.featured_image.width }}" height="{{ p.featured_image.height }}"
               alt="">
        {%- endif -%}
        {%- if v.compare_at_price > v.price -%}
          {%- assign pct = v.price | times: 100 | divided_by: v.compare_at_price -%}
          {%- assign pct = 100 | minus: pct -%}
          <span class="udc-rl__off">-{{ pct }}%</span>
        {%- endif -%}
      </a>
      <div class="udc-rl__body">
        <a class="udc-rl__title" href="{{ p.url }}">{{ p.title }}</a>
        <div class="udc-rl__prices">
          <span class="udc-rl__price">{{ v.price | money }}</span>
          {%- if v.compare_at_price > v.price -%}
            <s class="udc-rl__compare">{{ v.compare_at_price | money }}</s>
          {%- endif -%}
        </div>
        <form action="{{ routes.cart_add_url }}" method="post" class="udc-rl__form">
          <input type="hidden" name="id" value="{{ v.id }}">
          <input type="hidden" name="quantity" value="1">
          <button type="submit" class="udc-rl__add">{{ section.settings.add_text | default: '+ Agregar' }}</button>
        </form>
      </div>
    </article>
  {%- endfor -%}
{%- endcapture -%}

{%- if cards != blank -%}
  <section class="udc udc-top udc-rl" id="udc-rl-{{ section.id }}">
    <div class="udc-rl__head" data-udc-reveal>
      {%- if section.settings.eyebrow != blank -%}
        <span class="udc-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2 class="udc-h2 udc-rl__heading">
        {{ section.settings.title_1 }}
        {%- if section.settings.title_2 != blank -%}<br><span class="udc-serif udc-serif-glow">{{ section.settings.title_2 }}</span>{%- endif -%}
      </h2>
    </div>
    <div class="udc-rl__track" data-udc-reveal>
      {{ cards }}
    </div>
  </section>

  <style>
    #udc-rl-{{ section.id }}{position:relative}
    #udc-rl-{{ section.id }} .udc-rl__head{text-align:center}
    #udc-rl-{{ section.id }} .udc-rl__heading{margin-top:14px}

    #udc-rl-{{ section.id }} .udc-rl__track{
      display:grid;grid-auto-flow:column;grid-auto-columns:minmax(220px,72%);gap:16px;
      margin:36px auto 0;max-width:1080px;overflow-x:auto;scroll-snap-type:x mandatory;
      padding:6px 4px 18px;scrollbar-width:none}
    #udc-rl-{{ section.id }} .udc-rl__track::-webkit-scrollbar{display:none}
    @media (min-width:760px){
      #udc-rl-{{ section.id }} .udc-rl__track{
        grid-auto-flow:row;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));overflow:visible}
    }

    #udc-rl-{{ section.id }} .udc-rl__card{
      scroll-snap-align:start;display:flex;flex-direction:column;overflow:hidden;
      border:1px solid var(--udc-border);border-radius:18px;background:var(--udc-bg2);
      transition:border-color .25s ease,box-shadow .25s ease,transform .25s ease}
    #udc-rl-{{ section.id }} .udc-rl__card:hover{
      border-color:var(--udc-accent);transform:translateY(-3px);
      box-shadow:0 0 50px color-mix(in srgb, var(--udc-accent) 22%, transparent)}

    #udc-rl-{{ section.id }} .udc-rl__media{
      position:relative;display:block;aspect-ratio:4/3;overflow:hidden;background:var(--udc-bg)}
    #udc-rl-{{ section.id }} .udc-rl__media img{
      display:block;width:100%;height:100%;object-fit:cover;transition:transform .6s ease}
    #udc-rl-{{ section.id }} .udc-rl__card:hover .udc-rl__media img{transform:scale(1.05)}
    #udc-rl-{{ section.id }} .udc-rl__off{
      position:absolute;top:12px;left:12px;background:var(--udc-accent);color:#fff;
      font-family:var(--udc-anton);font-size:12px;letter-spacing:.04em;padding:5px 11px;border-radius:999px}

    #udc-rl-{{ section.id }} .udc-rl__body{display:flex;flex-direction:column;gap:10px;padding:16px 18px 18px;flex:1 1 auto}
    #udc-rl-{{ section.id }} .udc-rl__title{
      font-size:15px;line-height:1.35;font-weight:700;color:var(--udc-text);text-decoration:none;
      display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
    #udc-rl-{{ section.id }} .udc-rl__title:hover{color:var(--udc-accent)}
    #udc-rl-{{ section.id }} .udc-rl__prices{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap;margin-top:auto}
    #udc-rl-{{ section.id }} .udc-rl__price{font-family:var(--udc-anton);font-size:20px;color:var(--udc-text)}
    #udc-rl-{{ section.id }} .udc-rl__compare{font-size:13px;color:var(--udc-dim)}

    #udc-rl-{{ section.id }} .udc-rl__form{margin:0}
    #udc-rl-{{ section.id }} .udc-rl__add{
      width:100%;padding:11px 16px;border-radius:999px;cursor:pointer;
      font-family:var(--udc-anton);font-size:13px;letter-spacing:.06em;text-transform:uppercase;
      color:var(--udc-text);background:transparent;border:1px solid var(--udc-border);
      transition:background .2s ease,border-color .2s ease,box-shadow .2s ease}
    #udc-rl-{{ section.id }} .udc-rl__add:hover{
      background:var(--udc-accent);border-color:var(--udc-accent);color:#fff;
      box-shadow:0 0 30px color-mix(in srgb, var(--udc-accent) 45%, transparent)}

    @media (prefers-reduced-motion: reduce){
      #udc-rl-{{ section.id }} .udc-rl__card,
      #udc-rl-{{ section.id }} .udc-rl__media img{transition:none}
    }
  </style>
{%- endif -%}

{% schema %}
{
  "name": "UDC · Relacionados",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Seguí avanzando" },
    { "type": "text", "id": "title_1", "label": "Título · línea 1", "default": "También te puede" },
    { "type": "text", "id": "title_2", "label": "Título · línea 2 (serif itálica)", "default": "interesar" },
    { "type": "product_list", "id": "products", "label": "Productos", "limit": 8, "info": "Vacío = todos los productos de la tienda. El producto que se está viendo y los que ya están en el carrito se excluyen solos." },
    { "type": "range", "id": "limit", "label": "Máximo a mostrar", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "text", "id": "add_text", "label": "Texto del botón", "default": "+ Agregar" }
  ],
  "presets": [{ "name": "UDC · Relacionados" }]
}
{% endschema %}
