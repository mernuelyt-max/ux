{%- comment -%}
  UDC — Barra animada (arriba de todo)

  Copia de la barra del video de referencia del usuario: franja fina casi
  negra, texto blanco en mayúsculas con mucho espaciado entre letras,
  separado por estrellas ✦ blancas, que corre sin parar hacia la izquierda.
  El texto es una frase por línea (por defecto solo "OFERTA ESPECIAL"), y
  se repite las veces necesarias para cubrir el ancho; la fila va duplicada
  para que el loop sea continuo (udcMarquee de udc-base). El markup vive en
  snippets/udc-ticker.liquid (también lo usa udc-header).
{%- endcomment -%}

{% render 'udc-base' %}

{% render 'udc-ticker', sid: section.id, text: section.settings.text, speed: section.settings.speed, bg: section.settings.bg, fg: section.settings.fg %}

{% schema %}
{
  "name": "UDC · Barra animada",
  "tag": "div",
  "settings": [
    { "type": "textarea", "id": "text", "label": "Texto (una frase por línea)", "default": "OFERTA ESPECIAL" },
    { "type": "range", "id": "speed", "label": "Duración de una vuelta", "min": 10, "max": 80, "step": 2, "unit": "s", "default": 40 },
    { "type": "color", "id": "bg", "label": "Fondo", "default": "#0F0E11" },
    { "type": "color", "id": "fg", "label": "Texto y estrellas", "default": "#FFFFFF" }
  ],
  "presets": [{ "name": "UDC · Barra animada" }]
}
{% endschema %}
