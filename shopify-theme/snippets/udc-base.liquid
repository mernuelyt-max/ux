  @font-face{font-family:'Space Grotesk';font-style:normal;font-weight:700;font-display:swap;src:url("{{ '6411c373.woff2' | asset_url }}") format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}

  body{background:var(--udc-bg)}

  .udc{
    position:relative;padding:clamp(52px,8vh,88px) clamp(20px,5vw,72px);
    font-family:var(--udc-sans);color:var(--udc-text);background:var(--udc-bg);
    overflow-x:clip}
  /* En celular y tablet toda la landing se ve un 15% más chica: mismo diseño,
     misma proporción entre elementos. Una sola perilla para toda la tienda
     en vez de reglas de tamaño sección por sección. Cada sección tiene un
     solo .udc (no hay .udc anidados), así que no se reduce dos veces. */
  @media (max-width:749px){
    .udc{zoom:.85}
  }
  .udc-top{border-top:1px solid var(--udc-line)}
  .udc-clip{overflow:hidden}

  .udc-glow{
    position:absolute;z-index:0;border-radius:50%;pointer-events:none;
    background:radial-gradient(closest-side,var(--udc-accent),transparent 70%);
    animation:udcGlowPulse 5s ease-in-out infinite}

  .udc-eyebrow{display:inline-block;font-size:11px;letter-spacing:.28em;text-transform:uppercase;color:var(--udc-accent)}

  .udc-h2{margin:0;font-family:var(--udc-anton);font-weight:400;text-transform:uppercase;
    font-size:clamp(26px,3.4vw,46px);line-height:1.1}

  .udc-serif{font-family:var(--udc-serif-font);font-style:italic;text-transform:none;letter-spacing:0}
  .udc-serif-glow{text-shadow:0 0 26px color-mix(in srgb, var(--udc-accent) 70%, transparent)}

  .udc-accent{color:var(--udc-accent)}

  .udc-tag{display:inline-block;background:var(--udc-accent);color:#fff;font-size:10px;
    letter-spacing:.2em;text-transform:uppercase;font-weight:700;padding:4px 10px;border-radius:999px}
  .udc-tag--outline{background:transparent;border:1px solid var(--udc-accent);color:var(--udc-accent)}
  .udc-tag--ghost{background:transparent;border:1px solid #3A3A34;color:var(--udc-dim)}

  .udc-btn{position:relative;display:inline-flex;align-items:center;justify-content:center;gap:12px;
    background:var(--udc-accent);color:#fff;font-family:var(--udc-anton);
    font-size:clamp(15px,1.7vw,20px);letter-spacing:.06em;text-transform:uppercase;
    padding:18px 32px;border-radius:999px;
    box-shadow:0 0 60px color-mix(in srgb, var(--udc-accent) 50%, transparent);
    transition:transform .25s ease, box-shadow .25s ease}
  .udc-btn:hover{transform:scale(1.03);color:#fff;
    box-shadow:0 0 100px color-mix(in srgb, var(--udc-accent) 75%, transparent)}

  .udc-marquee{display:flex;width:max-content}
  .udc-marquee__row{display:flex;gap:14px;padding-right:14px}

  [data-udc-reveal]{opacity:1;transform:none;filter:none}
  .udc-js [data-udc-reveal]{
    opacity:0;transform:translateY(56px);filter:blur(10px);
    transition:opacity .9s cubic-bezier(.2,.65,.2,1),transform .9s cubic-bezier(.2,.65,.2,1),filter .9s cubic-bezier(.2,.65,.2,1)}
  .udc-js [data-udc-reveal].is-in{opacity:1;transform:none;filter:none}

  @keyframes udcMarquee{from{transform:translateX(0)}to{transform:translateX(-50%)}}
  @keyframes udcMarqueeR{from{transform:translateX(-50%)}to{transform:translateX(0)}}
  @keyframes udcGlowPulse{0%,100%{opacity:.35}50%{opacity:.75}}
  @keyframes udcBlink{0%,100%{opacity:1}50%{opacity:.15}}
  @keyframes udcFadeUp{0%{opacity:0;transform:translateY(40px)}100%{opacity:1;transform:none}}
  @keyframes udcFloaty{0%,100%{transform:translateY(0)}50%{transform:translateY(-12px)}}

  @media (prefers-reduced-motion: reduce){
    .udc-glow{animation:none}
    .udc-marquee{animation:none !important}
    .udc-js [data-udc-reveal]{transition:none}
  }
</style>

<script>
  document.documentElement.classList.add('udc-js');
  if (!window.__udcBaseInit) {
    window.__udcBaseInit = true;

    document.addEventListener('DOMContentLoaded', function () {
      var revealEls = Array.prototype.slice.call(document.querySelectorAll('[data-udc-reveal]'));
      if ('IntersectionObserver' in window) {
        var revealIo = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-in');
              revealIo.unobserve(entry.target);
            }
          });
        }, { threshold: 0.12 });
        revealEls.forEach(function (el) { revealIo.observe(el); });
      } else {
        revealEls.forEach(function (el) { el.classList.add('is-in'); });
      }

      var countEls = Array.prototype.slice.call(document.querySelectorAll('[data-udc-count]'));
      if (countEls.length) {
        var renderCount = function (el) {
          var end = parseFloat(el.getAttribute('data-udc-count'));
          var prefix = el.getAttribute('data-udc-prefix') || '';
          var suffix = el.getAttribute('data-udc-suffix') || '';
          if (isNaN(end)) return;
          var start = performance.now();
          var frame = function (now) {
            var progress = Math.min(1, (now - start) / 1400);
            var eased = 1 - Math.pow(1 - progress, 3);
            el.textContent = prefix + Math.round(end * eased) + suffix;
            if (progress < 1) requestAnimationFrame(frame);
          };
          requestAnimationFrame(frame);
        };
        if ('IntersectionObserver' in window) {
          var countIo = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              countIo.unobserve(entry.target);
              renderCount(entry.target);
            });
          }, { threshold: 0.5 });
          countEls.forEach(function (el) { countIo.observe(el); });
        } else {
          countEls.forEach(renderCount);
        }
      }
    });
  }
</script>
