{%- comment -%}
  UDC — Comportamiento de sections/udc-producto.liquid.
  Se renderiza con render 'udc-producto-js', sid: section.id

  Cuatro cosas, todas opcionales/progresivas:
   · Countdown de oferta (localStorage propio, mismo patrón que
     udc-01-temporizador — no se reinicia en cada visita).
   · Selector de cantidad / packs: clickear una tarjeta la marca como
     seleccionada y cambia el input oculto "id" del form al variant_id de
     esa tarjeta. Con packs también actualiza el precio de arriba y oculta
     el order bump si el pack elegido lo tiene marcado (pack_N_no_bump).
   · Al enviar el form, si hay JS, se intercepta y se agrega al carrito
     por Cart AJAX API (/cart/add.js) la variante elegida + el bump si
     está tildado, en un solo pedido, y se redirige a /cart. Si el fetch
     falla, se deja que el <form action="/cart/add"> normal siga su curso
     (agrega solo la variante principal, sin el bump).
   · Tabs Descripción/Entrega/Garantía: sin JS se ve solo "Descripción"
     (el panel con is-active de entrada); con JS, clickear un botón
     cambia cuál panel tiene is-active y por lo tanto cuál se ve.
{%- endcomment -%}

<script>
  (function () {
    var root = document.getElementById('udc-pp-{{ sid }}');
    if (!root) return;

    var countdown = root.querySelector('[data-udc-pp-countdown]');
    if (countdown) {
      var hours = parseFloat(countdown.getAttribute('data-hours')) || 24;
      var key = 'udc-pp-countdown-end-{{ sid }}';
      var end = parseInt(localStorage.getItem(key) || '0', 10);
      if (!end || end < Date.now()) {
        end = Date.now() + hours * 3600 * 1000;
        try { localStorage.setItem(key, String(end)); } catch (e) {}
      }
      var hEl = countdown.querySelector('[data-udc-pp-h]');
      var mEl = countdown.querySelector('[data-udc-pp-m]');
      var sEl = countdown.querySelector('[data-udc-pp-s]');
      var pad = function (n) { return String(n).padStart(2, '0'); };
      var tick = function () {
        var left = Math.max(0, end - Date.now());
        var total = Math.floor(left / 1000);
        if (hEl) hEl.textContent = pad(Math.floor(total / 3600));
        if (mEl) mEl.textContent = pad(Math.floor((total % 3600) / 60));
        if (sEl) sEl.textContent = pad(total % 60);
      };
      tick();
      setInterval(tick, 1000);
    }

    var sticky = document.getElementById('udc-pp-sticky-{{ sid }}');
    var stickyPrice = sticky ? sticky.querySelector('[data-udc-pp-sticky-price]') : null;

    var tierInput = root.querySelector('[data-udc-pp-variant-input]');
    var bumpBox = root.querySelector('[data-udc-pp-bump]');
    var priceBox = root.querySelector('[data-udc-pp-price]');
    var tiers = Array.prototype.slice.call(root.querySelectorAll('[data-udc-pp-tier-radio]'));
    tiers.forEach(function (radio) {
      radio.addEventListener('change', function () {
        tiers.forEach(function (r) { r.closest('.udc-pp__tier').classList.remove('is-selected'); });
        radio.closest('.udc-pp__tier').classList.add('is-selected');
        if (tierInput) tierInput.value = radio.value;
        if (stickyPrice && radio.getAttribute('data-price')) stickyPrice.textContent = radio.getAttribute('data-price');
        // Un pack que ya incluye el producto del bump (pack_N_no_bump) lo oculta
        // y lo destilda, para no agregarlo dos veces al carrito.
        if (bumpBox) {
          var noBump = radio.hasAttribute('data-no-bump');
          bumpBox.hidden = noBump;
          if (noBump) { var bt = bumpBox.querySelector('[data-udc-pp-bump-toggle]'); if (bt) bt.checked = false; }
        }
        // Packs (distintos productos): el precio de arriba sigue al pack elegido.
        // En el selector de cantidad no hay data-off y el precio de arriba no cambia.
        if (priceBox && radio.hasAttribute('data-off')) {
          var off = parseInt(radio.getAttribute('data-off'), 10) || 0;
          var now = priceBox.querySelector('.udc-pp__pricenow');
          var compare = priceBox.querySelector('.udc-pp__compare');
          var badge = priceBox.querySelector('.udc-pp__offbadge');
          if (now) now.textContent = radio.getAttribute('data-price');
          if (compare) { compare.textContent = radio.getAttribute('data-compare'); compare.hidden = off === 0; }
          if (badge) { badge.textContent = '-' + off + '% OFF'; badge.hidden = off === 0; }
        }
      });
    });

    var form = root.querySelector('.udc-pp__form');
    var bumpToggle = root.querySelector('[data-udc-pp-bump-toggle]');
    var bumpVariantInput = root.querySelector('[data-udc-pp-bump-variant-id]');

    if (form) {
      form.addEventListener('submit', function (evt) {
        evt.preventDefault();
        if (!tierInput) return;
        var items = [{ id: tierInput.value, quantity: 1 }];
        if (bumpToggle && bumpToggle.checked && bumpVariantInput) {
          items.push({ id: bumpVariantInput.value, quantity: 1 });
        }

        var submitBtn = form.querySelector('.udc-pp__add');
        if (submitBtn) submitBtn.disabled = true;

        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: items })
        })
          .then(function (res) { if (!res.ok) throw new Error('cart add failed'); return res.json(); })
          .then(function () { window.location.href = '/cart'; })
          .catch(function () { form.submit(); });
      });
    }

    var mainBtn = root.querySelector('.udc-pp__add');
    if (sticky && mainBtn && form && 'IntersectionObserver' in window) {
      // Moved to <body> so position:fixed can't be broken by a transformed ancestor.
      document.body.appendChild(sticky);
      var stickyBtn = sticky.querySelector('[data-udc-pp-sticky-btn]');
      new IntersectionObserver(function (entries) {
        var e = entries[0];
        var show = !e.isIntersecting && e.boundingClientRect.top < 0;
        sticky.classList.toggle('is-visible', show);
        if (stickyBtn) stickyBtn.tabIndex = show ? 0 : -1;
      }).observe(mainBtn);
      if (stickyBtn) {
        stickyBtn.addEventListener('click', function () {
          if (form.requestSubmit) form.requestSubmit(mainBtn); else mainBtn.click();
        });
      }
    }

    var tabBtns = Array.prototype.slice.call(root.querySelectorAll('[data-udc-pp-tabbtn]'));
    var tabPanels = Array.prototype.slice.call(root.querySelectorAll('[data-udc-pp-tabpanel]'));
    tabBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var target = btn.getAttribute('data-udc-pp-tabbtn');
        tabBtns.forEach(function (b) { b.classList.toggle('is-active', b === btn); });
        tabPanels.forEach(function (p) {
          p.classList.toggle('is-active', p.getAttribute('data-udc-pp-tabpanel') === target);
        });
      });
    });
  })();
</script>
