{%- comment -%}
  UDC — Íconos de línea (SVG inline, stroke = currentColor), estilo de los
  íconos de caffi.com.ar que el usuario pasó como referencia.
    render 'udc-icon', name: 'shield', size: 22
  Nombres: bolt, card, chat, shield, phone, check, question, leaf, truck,
  gift, clock, book, lock.
{%- endcomment -%}
{%- assign s = size | default: 22 -%}
<svg viewBox="0 0 24 24" width="{{ s }}" height="{{ s }}" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'bolt' -%}<path d="M13 2L4 14h7l-1 8 9-12h-7l1-8z"/>
    {%- when 'card' -%}<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18"/>
    {%- when 'chat' -%}<path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"/>
    {%- when 'shield' -%}<path d="M12 3l8 3v6c0 4.5-3.4 8.3-8 9-4.6-.7-8-4.5-8-9V6l8-3z"/>
    {%- when 'phone' -%}<rect x="7" y="2.5" width="10" height="19" rx="2"/><path d="M11 18h2"/>
    {%- when 'check' -%}<circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.6 2.5L16 9.5"/>
    {%- when 'question' -%}<path d="M4 4h16v12H9l-5 4V4z"/><path d="M10 8.5a2 2 0 1 1 2.6 1.9c-.4.2-.6.5-.6.9v.4"/><path d="M12 13.5h.01"/>
    {%- when 'leaf' -%}<path d="M5 19c0-8 5-13 15-14-1 10-6 15-14 15"/><path d="M5 19l7-7"/>
    {%- when 'truck' -%}<path d="M2 6h11v9H2z"/><path d="M13 9h4l3 3v3h-7z"/><circle cx="6" cy="17.5" r="1.8"/><circle cx="16.5" cy="17.5" r="1.8"/>
    {%- when 'gift' -%}<rect x="3" y="8" width="18" height="4" rx="1"/><path d="M5 12v9h14v-9M12 8v13"/><path d="M12 8c-2-3-6-3-6-.5S10 8 12 8zM12 8c2-3 6-3 6-.5S14 8 12 8z"/>
    {%- when 'clock' -%}<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>
    {%- when 'book' -%}<path d="M4 4.5A2.5 2.5 0 0 1 6.5 2H20v17H6.5A2.5 2.5 0 0 0 4 21.5z"/><path d="M4 21.5V4.5"/>
    {%- when 'lock' -%}<rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/>
    {%- else -%}<circle cx="12" cy="12" r="9"/>
  {%- endcase -%}
</svg>
