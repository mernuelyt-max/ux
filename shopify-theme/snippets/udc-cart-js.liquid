{%- comment -%}
  UDC — Comportamiento de sections/udc-cart.liquid.
  Se renderiza con render 'udc-cart-js', sid: section.id

  Mejora progresiva sobre el <form action="/cart">, que ya funciona solo
  (POST normal a /cart/update). Acá se intercepta:
    · los botones +/− y el input de cantidad → /cart/change.js
    · el link de quitar (item.url_to_remove) → la misma llamada con quantity 0
  Cada cambio pide también esta sección re-renderizada (Section Rendering
  API, parámetro "sections") y reemplaza su contenido, así el total, el
  ahorro y el precio tachado salen siempre del Liquid, sin duplicar cálculos
  de dinero en JS. Si algo falla, cae al form/link normal.
  El listener va sobre el <section> raíz, que no se reemplaza (solo su
  contenido), así que sigue funcionando después de cada re-render.
{%- endcomment -%}

<script>
  (function () {
    var sid = {{ sid | json }};
    var root = document.getElementById('udc-ct-' + sid);
    if (!root) return;

    var fallback = function (href) {
      if (href) { window.location.href = href; return; }
      var form = document.getElementById('udc-ct-form-' + sid);
      if (form) form.submit(); else window.location.reload();
    };

    var applyChange = function (line, quantity, lineEl, href) {
      if (lineEl) lineEl.classList.add('is-busy');
      fetch('/cart/change.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ line: line, quantity: quantity, sections: [sid] })
      })
        .then(function (res) { if (!res.ok) throw new Error('cart change failed'); return res.json(); })
        .then(function (cart) {
          var html = cart.sections && cart.sections[sid];
          if (!html) throw new Error('no section html');
          var doc = new DOMParser().parseFromString(html, 'text/html');
          var fresh = doc.getElementById('udc-ct-' + sid);
          if (!fresh) throw new Error('section not found');
          root.classList.add('is-live');
          root.innerHTML = fresh.innerHTML;
          root.querySelectorAll('[data-udc-reveal]').forEach(function (el) { el.classList.add('is-in'); });
          var total = root.querySelector('.udc-ct__total');
          if (total) total.classList.add('is-bump');
        })
        .catch(function () { fallback(href); });
    };

    root.addEventListener('click', function (evt) {
      var decBtn = evt.target.closest('[data-udc-cart-decrease]');
      var incBtn = evt.target.closest('[data-udc-cart-increase]');
      var removeLink = evt.target.closest('[data-udc-cart-remove]');

      if (decBtn || incBtn) {
        var input = (decBtn || incBtn).closest('.udc-ct__qty').querySelector('[data-udc-cart-qty]');
        var line = parseInt(input.getAttribute('data-line'), 10);
        var next = Math.max(0, (parseInt(input.value, 10) || 0) + (incBtn ? 1 : -1));
        input.value = next;
        applyChange(line, next, input.closest('.udc-ct__line'));
        return;
      }

      if (removeLink) {
        evt.preventDefault();
        var line2 = parseInt(removeLink.getAttribute('data-udc-cart-remove'), 10);
        applyChange(line2, 0, removeLink.closest('.udc-ct__line'), removeLink.href);
      }
    });

    root.addEventListener('change', function (evt) {
      var input = evt.target.closest('[data-udc-cart-qty]');
      if (!input) return;
      var line = parseInt(input.getAttribute('data-line'), 10);
      var quantity = Math.max(0, parseInt(input.value, 10) || 0);
      applyChange(line, quantity, input.closest('.udc-ct__line'));
    });

    root.addEventListener('submit', function (evt) {
      var btn = evt.submitter;
      if (btn && btn.name === 'checkout') btn.classList.add('is-busy');
    });
  })();
</script>
