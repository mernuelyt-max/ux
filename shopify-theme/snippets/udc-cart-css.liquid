{%- comment -%}
  UDC — Estilos de sections/udc-cart.liquid.
  Vive en su propio archivo por el mismo motivo que udc-planes-css.liquid:
  no encoger la sección con CSS adentro. Se renderiza DENTRO del <style> de
  la sección y necesita un parámetro, porque render abre un ámbito nuevo:
    render 'udc-cart-css', sid: section.id
{%- endcomment -%}

  #udc-ct-{{ sid }}{overflow:hidden}
  #udc-ct-{{ sid }} .udc-ct__glow{width:520px;height:520px;top:-220px;left:50%;margin-left:-260px;opacity:.35}

  #udc-ct-{{ sid }} .udc-ct__head{
    position:relative;z-index:1;max-width:1080px;margin:0 auto;text-align:center;
    display:flex;flex-direction:column;align-items:center;gap:12px}
  #udc-ct-{{ sid }} .udc-ct__count{
    font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--udc-muted);
    border:1px solid var(--udc-border);border-radius:999px;padding:6px 14px}

  /* ---------- vacío ---------- */
  #udc-ct-{{ sid }} .udc-ct__empty{
    position:relative;z-index:1;max-width:560px;margin:40px auto 0;padding:48px 24px;text-align:center;
    border:1px solid var(--udc-border);border-radius:22px;background:var(--udc-bg2);
    display:flex;flex-direction:column;align-items:center;gap:20px;color:var(--udc-accent)}
  #udc-ct-{{ sid }} .udc-ct__empty p{margin:0;color:var(--udc-muted);font-size:15px}

  /* ---------- layout ---------- */
  #udc-ct-{{ sid }} .udc-ct__grid{
    position:relative;z-index:1;display:grid;grid-template-columns:1fr;gap:clamp(24px,4vw,40px);
    max-width:1080px;margin:clamp(28px,5vw,44px) auto 0}
  @media (min-width:900px){
    #udc-ct-{{ sid }} .udc-ct__grid{grid-template-columns:minmax(0,1fr) 380px;align-items:start}
    #udc-ct-{{ sid }} .udc-ct__summary{position:sticky;top:24px}
  }

  /* ---------- líneas ---------- */
  #udc-ct-{{ sid }} .udc-ct__lines{display:flex;flex-direction:column;gap:14px}

  #udc-ct-{{ sid }} .udc-ct__line{
    display:grid;grid-template-columns:96px minmax(0,1fr) auto;gap:18px;align-items:start;
    padding:16px;border:1px solid var(--udc-border);border-radius:18px;background:var(--udc-bg2);
    transition:border-color .25s ease,box-shadow .25s ease;
    animation:udcFadeUp .7s cubic-bezier(.2,.65,.2,1) both;animation-delay:calc(var(--i) * 90ms)}
  #udc-ct-{{ sid }} .udc-ct__line:hover{
    border-color:color-mix(in srgb, var(--udc-accent) 60%, transparent);
    box-shadow:0 0 40px color-mix(in srgb, var(--udc-accent) 18%, transparent)}
  #udc-ct-{{ sid }}.is-live .udc-ct__line{animation:none}
  #udc-ct-{{ sid }} .udc-ct__line.is-busy{opacity:.55;pointer-events:none}
  @media (max-width:560px){
    #udc-ct-{{ sid }} .udc-ct__line{grid-template-columns:76px minmax(0,1fr);gap:14px}
    #udc-ct-{{ sid }} .udc-ct__linetotal{grid-column:1 / -1;justify-self:end}
  }

  #udc-ct-{{ sid }} .udc-ct__thumb{
    position:relative;display:block;aspect-ratio:1;border-radius:14px;overflow:hidden;
    border:1px solid var(--udc-border);background:var(--udc-bg)}
  #udc-ct-{{ sid }} .udc-ct__thumb img{display:block;width:100%;height:100%;object-fit:cover}
  #udc-ct-{{ sid }} .udc-ct__off{
    position:absolute;top:6px;left:6px;background:var(--udc-accent);color:#fff;
    font-family:var(--udc-anton);font-size:11px;letter-spacing:.04em;padding:3px 8px;border-radius:999px;
    box-shadow:0 0 18px color-mix(in srgb, var(--udc-accent) 60%, transparent)}

  #udc-ct-{{ sid }} .udc-ct__info{display:flex;flex-direction:column;gap:6px;min-width:0}
  #udc-ct-{{ sid }} .udc-ct__name{
    font-family:var(--udc-anton);font-size:clamp(15px,1.6vw,18px);line-height:1.2;text-transform:uppercase;
    color:var(--udc-text);text-decoration:none}
  #udc-ct-{{ sid }} .udc-ct__name:hover{color:var(--udc-accent)}
  #udc-ct-{{ sid }} .udc-ct__variant{
    align-self:flex-start;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--udc-accent);
    border:1px solid color-mix(in srgb, var(--udc-accent) 55%, transparent);border-radius:999px;padding:3px 10px}
  #udc-ct-{{ sid }} .udc-ct__price{font-size:14px;color:var(--udc-text)}
  #udc-ct-{{ sid }} .udc-ct__price s{color:var(--udc-dim);margin-left:6px;font-size:13px}

  #udc-ct-{{ sid }} .udc-ct__row{display:flex;align-items:center;gap:16px;margin-top:6px;flex-wrap:wrap}

  #udc-ct-{{ sid }} .udc-ct__qty{
    display:inline-flex;align-items:center;border:1px solid var(--udc-border);border-radius:999px;overflow:hidden}
  #udc-ct-{{ sid }} .udc-ct__qtybtn{
    width:36px;height:36px;border:0;background:transparent;color:var(--udc-text);
    font-size:16px;cursor:pointer;line-height:1;transition:color .2s ease,background .2s ease}
  #udc-ct-{{ sid }} .udc-ct__qtybtn:hover{color:#fff;background:var(--udc-accent)}
  #udc-ct-{{ sid }} .udc-ct__qtyinput{
    width:36px;border:0;background:transparent;color:var(--udc-text);text-align:center;
    font-size:14px;font-family:var(--udc-sans);-moz-appearance:textfield}
  #udc-ct-{{ sid }} .udc-ct__qtyinput::-webkit-outer-spin-button,
  #udc-ct-{{ sid }} .udc-ct__qtyinput::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}

  #udc-ct-{{ sid }} .udc-ct__remove{
    display:inline-flex;align-items:center;gap:6px;font-size:12px;letter-spacing:.08em;text-transform:uppercase;
    color:var(--udc-dim);text-decoration:none;transition:color .2s ease}
  #udc-ct-{{ sid }} .udc-ct__remove:hover{color:var(--udc-accent)}

  #udc-ct-{{ sid }} .udc-ct__linetotal{
    font-family:var(--udc-anton);font-size:clamp(16px,1.8vw,20px);color:var(--udc-text);white-space:nowrap}

  #udc-ct-{{ sid }} .udc-ct__update{
    align-self:flex-start;border:1px solid var(--udc-border);background:transparent;
    color:var(--udc-muted);font-size:12px;letter-spacing:.1em;text-transform:uppercase;
    padding:10px 18px;border-radius:999px;cursor:pointer}

  #udc-ct-{{ sid }} .udc-ct__continue{
    align-self:flex-start;margin-top:6px;font-size:12px;letter-spacing:.14em;text-transform:uppercase;
    color:var(--udc-muted);text-decoration:none;transition:color .2s ease}
  #udc-ct-{{ sid }} .udc-ct__continue:hover{color:var(--udc-accent)}

  /* ---------- resumen ---------- */
  #udc-ct-{{ sid }} .udc-ct__card{
    position:relative;display:flex;flex-direction:column;gap:14px;padding:24px;border-radius:22px;
    background:var(--udc-bg2);border:1px solid color-mix(in srgb, var(--udc-accent) 55%, transparent);
    animation:udcCtGlow 3.2s ease-in-out infinite}
  @keyframes udcCtGlow{
    0%,100%{box-shadow:0 0 30px color-mix(in srgb, var(--udc-accent) 18%, transparent)}
    50%{box-shadow:0 0 70px color-mix(in srgb, var(--udc-accent) 38%, transparent)}}

  #udc-ct-{{ sid }} .udc-ct__cardtitle{
    font-family:var(--udc-anton);font-size:14px;letter-spacing:.08em;text-transform:uppercase;
    padding-bottom:14px;border-bottom:1px solid var(--udc-line)}

  #udc-ct-{{ sid }} .udc-ct__sumrow{
    display:flex;align-items:baseline;justify-content:space-between;gap:12px;font-size:14px;color:var(--udc-muted)}
  #udc-ct-{{ sid }} .udc-ct__sumrow s{color:var(--udc-dim)}
  #udc-ct-{{ sid }} .udc-ct__sumrow--save{color:var(--udc-accent);font-weight:700}
  #udc-ct-{{ sid }} .udc-ct__sumrow--total{
    padding-top:14px;border-top:1px solid var(--udc-line);color:var(--udc-text);
    font-family:var(--udc-anton);text-transform:uppercase;letter-spacing:.04em}
  #udc-ct-{{ sid }} .udc-ct__total{font-size:clamp(22px,2.6vw,28px);letter-spacing:0}
  #udc-ct-{{ sid }} .udc-ct__total.is-bump{animation:udcCtBump .5s ease}
  @keyframes udcCtBump{0%{transform:scale(1)}40%{transform:scale(1.08);color:var(--udc-accent)}100%{transform:scale(1)}}

  #udc-ct-{{ sid }} .udc-ct__note{margin:-4px 0 0;font-size:12px;color:var(--udc-dim);text-align:right}

  #udc-ct-{{ sid }} .udc-ct__checkout{width:100%;margin-top:6px;overflow:hidden;border:0;cursor:pointer}
  #udc-ct-{{ sid }} .udc-ct__checkout.is-busy{opacity:.6;pointer-events:none}
  #udc-ct-{{ sid }} .udc-ct__shine{
    position:absolute;top:0;bottom:0;left:-60%;width:40%;pointer-events:none;
    background:linear-gradient(100deg,transparent,rgba(255,255,255,.35),transparent);
    transform:skewX(-20deg);animation:udcCtShine 3.2s ease-in-out infinite}
  @keyframes udcCtShine{0%,55%{left:-60%}100%{left:130%}}

  #udc-ct-{{ sid }} .udc-ct__secure{
    margin:0;display:flex;align-items:center;justify-content:center;gap:8px;font-size:13px;color:var(--udc-muted)}

  #udc-ct-{{ sid }} .udc-ct__pay{display:flex;flex-wrap:wrap;justify-content:center;gap:8px}
  #udc-ct-{{ sid }} .udc-ct__pay span{
    font-size:11px;letter-spacing:.04em;color:var(--udc-muted);
    border:1px solid var(--udc-border);border-radius:8px;padding:6px 12px}

  #udc-ct-{{ sid }} .udc-ct__badges{display:flex;flex-wrap:wrap;justify-content:center;gap:10px;margin-top:16px}
  #udc-ct-{{ sid }} .udc-ct__badges > span{
    display:inline-flex;align-items:center;gap:8px;font-size:12px;color:var(--udc-text);
    border:1px solid var(--udc-border);border-radius:999px;padding:9px 16px}

  @media (prefers-reduced-motion: reduce){
    #udc-ct-{{ sid }} .udc-ct__line,
    #udc-ct-{{ sid }} .udc-ct__card,
    #udc-ct-{{ sid }} .udc-ct__shine,
    #udc-ct-{{ sid }} .udc-ct__total.is-bump{animation:none}
  }
